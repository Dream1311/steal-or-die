-- ===== HSV -> Color3 =====
local function hsv(h, s, v)
    h = (h % 1) * 6
    local i = math.floor(h)
    local f = h - i
    local p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
    local r, g, b
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return C(math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
end

-- ===== key names =====
local KN = {[0x08]="BACKSPACE",[0x09]="TAB",[0x0D]="ENTER",[0x10]="SHIFT",[0x11]="CTRL",
    [0x12]="ALT",[0x14]="CAPS",[0x20]="SPACE",[0x21]="PGUP",[0x22]="PGDN",[0x23]="END",
    [0x24]="HOME",[0x25]="LEFT",[0x26]="UP",[0x27]="RIGHT",[0x28]="DOWN",[0x2D]="INSERT",
    [0x2E]="DELETE",[0xA0]="LSHIFT",[0xA1]="RSHIFT",[0xA2]="LCTRL",[0xA3]="RCTRL",
    [0xA4]="LALT",[0xA5]="RALT",[0xC0]="~",[0xDB]="[",[0xDD]="]",[0xBA]=";",[0xDE]="'",
    [0xBC]=",",[0xBE]=".",[0xBF]="/",[0xDC]="\\",[0xBD]="-",[0xBB]="="}
for i = 1, 12 do KN[0x6F + i] = "F" .. i end
for i = 0, 9 do KN[0x30 + i] = tostring(i) end
for i = 0, 25 do KN[0x41 + i] = string.char(65 + i) end
for i = 0, 9 do KN[0x60 + i] = "NUM" .. i end
local function keyName(c) return KN[c] or string.format("KEY 0x%02X", c) end

