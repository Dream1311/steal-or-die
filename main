-- Steal or Die ESP v23: menu (drag + rebind + palette) + loot + monsters (2D box) + alert + instant grab
-- anti-freeze: per-frame pcall, staged scan, cached mouse/viewport

if _G.ESP_CLEAN then pcall(_G.ESP_CLEAN) end
local TOKEN = tostring(os.clock())
_G.ESP_TOKEN = TOKEN

local lp
repeat
    local ok, p = pcall(function() return game:GetService("Players").LocalPlayer end)
    if ok and p then lp = p end
    if not lp then wait(0.5) end
until lp
repeat wait(0.2) until workspace and workspace.CurrentCamera

