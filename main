for i, it in ipairs(items) do
    it.ry = TH + 4 + (i - 1) * RH
    if it.k == "h" then
        it.lt = tx(12, C_HEAD, it.l)
        it.ln = sq(C_BAR)
    else
        it.lt = tx(14, WHITE, it.l)
    end
    if it.k == "t" then
        it.tr = sq(C_OFF)
        it.kn = sq(WHITE)
    elseif it.k == "c" then
        it.so = sq(BLACK)
        it.s = sq(WHITE)
    elseif it.k == "b" then
        it.v = tx(14, ACCENT, "")
    elseif it.k == "s" then
        it.st = sq(C_OFF)
        it.sf = sq(ACCENT)
        it.sk = sq(WHITE)
        it.sv = tx(13, ACCENT, "")
    end
end

-- ===== color palette (popup) =====
local COLS, CS, STEP = 14, 18, 20
local PROWS = {{0.45,1}, {0.75,1}, {1,1}, {1,0.75}, {1,0.5}}
local PW = COLS * STEP + 12
local PH = 32 + (#PROWS + 1) * STEP + 4
local pOut = sq(ACCENT, false, plist)
pOut.Thickness = 1
local pbg  = sq(C_BG, true, plist)
local pbar = sq(C_BAR, true, plist)
local ptt  = tx(14, WHITE, "Color", plist)
local ppv  = sq(WHITE, true, plist)
local ppo  = sq(BLACK, false, plist)
ppo.Thickness = 1

local cells = {}
for r = 1, #PROWS do
    for c = 1, COLS do
        local col = hsv((c - 1) / COLS, PROWS[r][1], PROWS[r][2])
        cells[#cells + 1] = {d = sq(col, true, plist), col = col, r = r, c = c}
    end
end
for c = 1, COLS do
    local v = 1 - (c - 1) / (COLS - 1)
    local col = hsv(0, 0, v)
    cells[#cells + 1] = {d = sq(col, true, plist), col = col, r = #PROWS + 1, c = c}
end
local phl = sq(WHITE, false, plist)
phl.Thickness = 2

local popOpen, popIt, hovCell = false, nil, nil

local function playout()
    local px, py = MX + MW + 8, MY
    pOut.Position = Vector2.new(px - 1, py - 1)
    pOut.Size = Vector2.new(PW + 2, PH + 2)
    pbg.Position = Vector2.new(px, py)
    pbg.Size = Vector2.new(PW, PH)
    pbar.Position = Vector2.new(px, py)
    pbar.Size = Vector2.new(PW, 26)
    ptt.Position = Vector2.new(px + 8, py + 5)
    ppv.Position = Vector2.new(px + PW - 40, py + 5)
    ppv.Size = Vector2.new(32, 16)
    ppo.Position = Vector2.new(px + PW - 41, py + 4)
    ppo.Size = Vector2.new(34, 18)
    for _, cl in ipairs(cells) do
        cl.x = px + 6 + (cl.c - 1) * STEP
        cl.y = py + 32 + (cl.r - 1) * STEP
        cl.d.Position = Vector2.new(cl.x, cl.y)
        cl.d.Size = Vector2.new(CS, CS)
    end
    phl.Size = Vector2.new(CS + 4, CS + 4)
end

local function cellAt(x, y)
    for _, cl in ipairs(cells) do
        if x >= cl.x and x < cl.x + CS and y >= cl.y and y < cl.y + CS then return cl end
    end
    return nil
end

local function inPopup(x, y)
    local px, py = MX + MW + 8, MY
    return x >= px and x <= px + PW and y >= py and y <= py + PH
end

local function closePopup()
    popOpen, popIt, hovCell = false, nil, nil
    for _, d in ipairs(plist) do d.Visible = false end
end

local function openPopup(it)
    popIt, popOpen, hovCell = it, true, nil
    playout()
    ptt.Text = "Color: " .. it.l
    ppv.Color = it.t[it.key]
    for _, d in ipairs(plist) do d.Visible = true end
    phl.Visible = false
end

-- ===== menu: layout =====
local function refresh(it)
    local cx = MX + MW - 52
    local y = MY + it.ry
    if it.k == "t" then
        local on = it.t[it.key]
        it.tr.Color = on and GREEN or C_OFF
        it.kn.Position = Vector2.new(cx + (on and 24 or 3), y + 6)
    elseif it.k == "c" then
        it.s.Color = it.t[it.key]
    elseif it.k == "s" then
        local v = it.t[it.key]
        local f = v / SL_MAX
        if f < 0 then f = 0 elseif f > 1 then f = 1 end
        it.sf.Position = Vector2.new(MX + SL_X, y + 8)
        it.sf.Size = Vector2.new(math.max(1, SL_W * f), 6)
        it.sk.Position = Vector2.new(MX + SL_X + SL_W * f - 3, y + 4)
        it.sv.Text = (v <= 0) and "all" or ("$" .. v)
    elseif it.k == "b" then
        it.v.Text = it.listen and "[ press key... ]" or ("[" .. keyName(KEYS[it.key]) .. "]")
        it.v.Color = it.listen and YELLOW or ACCENT
    end
end

local function layout()
    bgOut.Position = Vector2.new(MX - 1, MY - 1)
    bgOut.Size = Vector2.new(MW + 2, HEIGHT + 2)
    bg.Position = Vector2.new(MX, MY)
    bg.Size = Vector2.new(MW, HEIGHT)
    bar.Position = Vector2.new(MX, MY)
    bar.Size = Vector2.new(MW, TH)
    accent.Position = Vector2.new(MX, MY + TH - 2)
    accent.Size = Vector2.new(MW, 2)
    ttl.Position = Vector2.new(MX + 10, MY + 6)
    sub.Position = Vector2.new(MX + MW - 58, MY + 8)
    for _, it in ipairs(items) do
        local y = MY + it.ry
        local cx = MX + MW - 52
        if it.k == "h" then
            it.lt.Position = Vector2.new(MX + 10, y + 4)
            it.ln.Position = Vector2.new(MX + 8, y + RH - 3)
            it.ln.Size = Vector2.new(MW - 16, 1)
        else
            it.lt.Position = Vector2.new(MX + 14, y + 3)
        end
        if it.k == "t" then
            it.tr.Position = Vector2.new(cx, y + 4)
            it.tr.Size = Vector2.new(38, 14)
            it.kn.Size = Vector2.new(10, 10)
        elseif it.k == "c" then
            it.so.Position = Vector2.new(cx - 1, y + 3)
            it.so.Size = Vector2.new(40, 16)
            it.s.Position = Vector2.new(cx, y + 4)
            it.s.Size = Vector2.new(38, 14)
        elseif it.k == "b" then
            it.v.Position = Vector2.new(MX + MW - 130, y + 3)
        elseif it.k == "s" then
            it.st.Position = Vector2.new(MX + SL_X, y + 8)
            it.st.Size = Vector2.new(SL_W, 6)
            it.sk.Size = Vector2.new(6, 14)
            it.sv.Position = Vector2.new(MX + SL_X + SL_W + 8, y + 4)
        end
        refresh(it)
    end
    if popOpen then playout() end      -- palette is laid out only while it is open
end

local menuOpen = true
local hoverIt = nil
local function setMenu(b)
    for _, d in ipairs(mlist) do d.Visible = b end
    hl.Visible = false
    hoverIt = nil
    if not b then closePopup() end
end
layout()
setMenu(true)

local function removeAll()
    for _, s in ipairs(pool) do pcall(function() s.t:Remove() end) end
    for _, s in ipairs(alerts) do pcall(function() s.t:Remove() end) end
    for _, s in ipairs(boxes) do
        pcall(function() s.ol:Remove() end)
        pcall(function() s.b:Remove() end)
        pcall(function() s.t:Remove() end)
    end
    for _, d in ipairs(mlist) do pcall(function() d:Remove() end) end
    for _, d in ipairs(plist) do pcall(function() d:Remove() end) end
end

_G.ESP_CLEAN = function()
    _G.ESP_TOKEN = nil
    removeAll()
end

-- ===== input =====
local mouseObj = nil
local function mousePos()
    if mouseObj == nil then
        local ok, m = pcall(function() return lp:GetMouse() end)
        mouseObj = (ok and m) or false      -- fetched once, not every frame
    end
    if mouseObj then
        local ok, x, y = pcall(function() return mouseObj.X, mouseObj.Y end)
        if ok and type(x) == "number" then return x, y end
    end
    local ok, x, y = pcall(function()
        local p = getmouseposition()
        return p.X, p.Y
    end)
    if ok and type(x) == "number" then return x, y end
    return nil
end

local function keyDown(c)
    local ok, v = pcall(iskeypressed, c)
    return ok and v
end

local function click(it)
    if it.k == "t" then
        it.t[it.key] = not it.t[it.key]
        refresh(it)
    elseif it.k == "c" then
        openPopup(it)
    elseif it.k == "b" then
        it.listen = true
        refresh(it)
    end
end

local function scanKey()
    for c = 8, 254 do
        if c ~= 1 and c ~= 2 and c ~= 4 and c ~= 5 and c ~= 6 and keyDown(c) then
            return c
        end
    end
    return nil
end

-- ===== helpers =====
local function xyz(part)
    local p = part.Position
    return p.X, p.Y, p.Z
end

local function getPart(o)
    if BASE[o.ClassName] then return o end
    return o:FindFirstChild("HumanoidRootPart")
        or o.PrimaryPart
        or o:FindFirstChildWhichIsA("BasePart")
end

local function attr(o, k)
    local ok, v = pcall(o.GetAttribute, o, k)
    if ok then return v end
    return nil
end

local function boxHeight(part)
    local h = 5.5
    if part.Name ~= "HumanoidRootPart" then
        local ok, sy = pcall(function() return part.Size.Y end)
        if ok and type(sy) == "number" and sy > 1 then h = sy end
    end
    return h
end

-- ===== LootTemplates fallback =====
local LootTemplates = nil
local function getTemplate(name)
    if LootTemplates == nil then
        local ok, f = pcall(function()
            return game:GetService("ReplicatedStorage"):FindFirstChild("LootTemplates")
        end)
        LootTemplates = (ok and f) or false
    end
    if not LootTemplates then return nil end
    local ok, t = pcall(function() return LootTemplates:FindFirstChild(name) end)
    return (ok and t) or nil
end

-- ===== staged scan (a few items per frame, no big hitch) =====
local loot, mons = {}, {}
local sc = {stage = 0, nextAt = 0, q = {}, qi = 1, nl = {}, nm = {}, cand = nil, ci = 1}

local function buildLoot(o)
    local part = getPart(o)
    if not part then return nil end
    local r = attr(o, "Rarity")
    local v = tonumber(attr(o, "Value"))
    local w = tonumber(attr(o, "Weight"))
    -- если атрибуты пропали с живого лута — берём из LootTemplates
    if (r == nil or v == nil or w == nil) and ITEM_SET[o.Name] then
        local tmpl = getTemplate(o.Name)
        if tmpl then
            if r == nil then r = attr(tmpl, "Rarity") end
            if v == nil then v = tonumber(attr(tmpl, "Value")) end
            if w == nil then w = tonumber(attr(tmpl, "Weight")) end
        end
    end
    r = r and string.lower(tostring(r)) or nil
    local base = o.Name
    if v then base = base .. " $" .. math.floor(v) end
    if w then base = base .. " " .. (math.floor(w * 10 + 0.5) / 10) .. "kg" end
    return {part = part, obj = o, base = base, rk = r, val = v or 0, dm = -1, txt = base}
end

local function scanStep(now)
    local s = sc
    if s.stage == 0 then
        if now >= s.nextAt then
            s.q = {}
            for _, fn in ipairs(LOOT_FOLDERS) do
                local f = workspace:FindFirstChild(fn)
                if f then
                    local ok, kids = pcall(function() return f:GetChildren() end)
                    if ok and kids then
                        for i = 1, #kids do s.q[#s.q + 1] = kids[i] end
                    end
                end
            end
            s.qi, s.nl, s.nm, s.cand, s.ci = 1, {}, {}, nil, 1
            s.stage = 1
        end
    elseif s.stage == 1 then
        local n = 0
        while s.qi <= #s.q and n < BUDGET do
            local o = s.q[s.qi]
            s.qi = s.qi + 1
            n = n + 1
            local ok, e = pcall(buildLoot, o)
            if ok and e then s.nl[#s.nl + 1] = e end
        end
        if s.qi > #s.q then s.stage = 2 end
    elseif s.stage == 2 then
        -- снимок прямых детей workspace (монстры и The Tenant — прямые дети)
        if not s.cand then
            s.cand = {}
            local root = workspace:FindFirstChild("Monsters") or workspace
            local ok, kids = pcall(function() return root:GetChildren() end)
            if ok and kids then
                for i = 1, #kids do s.cand[i] = kids[i] end
            end
            s.ci, s.nm = 1, {}
        end

        local n = 0
        while s.ci <= #s.cand and n < 10 do
            local o = s.cand[s.ci]
            s.ci = s.ci + 1
            n = n + 1
            local cls = o.ClassName
            -- быстрый фильтр: проверяем атрибут только у Model/Folder
            if cls == "Model" or cls == "Folder" then
                local ek = attr(o, "EntityKind")
                if ek then
                    local disp = ENTITY_NAME[string.lower(tostring(ek))]
                    if disp then
                        local ok, part = pcall(getPart, o)
                        if ok and part then
                            s.nm[#s.nm + 1] = {
                                part = part, base = disp,
                                h = boxHeight(part), dm = -1, txt = disp,
                            }
                        end
                    end
                end
            end
        end

        if s.ci > #s.cand then
            loot, mons = s.nl, s.nm
            s.stage = 0
            s.nextAt = now + SCAN_EVERY
            s.cand = nil
        end
    end
end

-- ===== instant grab (safe version) =====
-- GRAB_MODE: 1 = fireproximityprompt, 2 = simulate key E (fallback if mode 1 crashes)
local GRAB_MODE = 1
local lastGrab = 0

-- no recursive search: look only at the item, its children, and grandchildren
local function findPrompt(o)
    local function scan(parent)
        local ok, kids = pcall(function() return parent:GetChildren() end)
        if not ok or not kids then return nil end
        for i = 1, #kids do
            local okc, cn = pcall(function() return kids[i].ClassName end)
            if okc and cn == "ProximityPrompt" then return kids[i] end
        end
        return nil, kids
    end
    local p, kids = scan(o)
    if p then return p end
    if kids then
        for i = 1, #kids do
            local p2 = scan(kids[i])
            if p2 then return p2 end
        end
    end
    return nil
end

local function doGrab(mx, my, mz)
    local best, bd = nil, GRAB_RANGE * GRAB_RANGE
    for i = 1, #loot do
        local e = loot[i]
        local ok, x, y, z = pcall(xyz, e.part)
        if ok and x then
            local dx, dy, dz = x - mx, y - my, z - mz
            local d2 = dx*dx + dy*dy + dz*dz
            if d2 < bd then bd, best = d2, e end
        end
    end
    if not best then return end

    if GRAB_MODE == 2 then
        pcall(keypress, 0x45)
        task.spawn(function()
            task.wait(0.05)
            pcall(keyrelease, 0x45)
        end)
        return
    end

    local pr = best.prompt
    if not pr then
        pr = findPrompt(best.obj)
        best.prompt = pr or false
    end
    if not pr then
        return
    end

    if not fireproximityprompt then
        return
    end
    pcall(fireproximityprompt, pr)
end

-- ===== main frame =====
local frame = 0
local wasKey, wasMouse = false, false
local dragging, offx, offy, dirty = false, 0, 0, false
local listenItem = nil
local sliding = nil
local lootMax2 = LOOT_DIST * LOOT_DIST
local vpX, vpAt = 960, 0

local function step(now)
    frame = frame + 1
    scanStep(now)

    -- ===== input: key rebind, open/close =====
    if listenItem then
        if keyDown(0x1B) then
            listenItem.listen = false
            refresh(listenItem)
            listenItem = nil
            wasKey = true
        else
            local c = scanKey()
            if c then
                KEYS[listenItem.key] = c
                listenItem.listen = false
                refresh(listenItem)
                listenItem = nil
                wasKey = true
            end
        end
    else
        local kd = keyDown(KEYS.menu)
        if kd and not wasKey then
            menuOpen = not menuOpen
            setMenu(menuOpen)
        end
        wasKey = kd
    end

    -- ===== mouse: drag, palette, clicks =====
    local okm, mv = pcall(ismouse1pressed)
    local md = (okm and mv) and true or false
    if menuOpen then
        local x, y = mousePos()
        if x then
            if popOpen then
                local hc = cellAt(x, y)
                if hc ~= hovCell then
                    hovCell = hc
                    if hc then
                        phl.Position = Vector2.new(hc.x - 2, hc.y - 2)
                        phl.Visible = true
                    else
                        phl.Visible = false
                    end
                end
            end

            if md and not wasMouse then
                local consumed, prev = false, nil
                if popOpen then
                    if inPopup(x, y) then
                        consumed = true
                        local cl = cellAt(x, y)
                        if cl then
                            popIt.t[popIt.key] = cl.col
                            refresh(popIt)
                            closePopup()
                        end
                    else
                        prev = popIt
                        closePopup()
                    end
                end
                if not consumed then
                    if x >= MX and x <= MX + MW and y >= MY and y <= MY + TH then
                        dragging = true
                        offx, offy = x - MX, y - MY
                    elseif x >= MX and x <= MX + MW then
                        for _, it in ipairs(items) do
                            if it.k ~= "h" and it ~= prev and y >= MY + it.ry and y < MY + it.ry + RH then
                                if it.k == "s" then
                                    if x >= MX + SL_X - 6 and x <= MX + SL_X + SL_W + 6 then sliding = it end
                                else
                                    click(it)
                                    if it.listen then listenItem = it end
                                end
                                break
                            end
                        end
                    end
                end
            end

            if dragging then
                if md then
                    local nx, ny = x - offx, y - offy
                    if nx < 0 then nx = 0 end
                    if ny < 0 then ny = 0 end
                    if nx ~= MX or ny ~= MY then
                        MX, MY = nx, ny
                        dirty = true
                    end
                    if dirty and frame % 2 == 0 then
                        dirty = false
                        layout()
                        hl.Visible = false
                        hoverIt = nil
                    end
                else
                    dragging = false
                    if dirty then
                        dirty = false
                        layout()
                    end
                end
            end

            if sliding then
                if md then
                    local f = (x - (MX + SL_X)) / SL_W
                    if f < 0 then f = 0 elseif f > 1 then f = 1 end
                    local v = math.floor(f * SL_MAX / SL_STEP + 0.5) * SL_STEP
                    if v ~= sliding.t[sliding.key] then
                        sliding.t[sliding.key] = v
                        refresh(sliding)
                    end
                else
                    sliding = nil
                end
            end

            local hit = nil
            if not dragging and not (popOpen and inPopup(x, y)) and x >= MX and x <= MX + MW then
                for _, it in ipairs(items) do
                    if it.k ~= "h" and y >= MY + it.ry and y < MY + it.ry + RH then
                        hit = it
                        break
                    end
                end
            end
            if hit ~= hoverIt then
                hoverIt = hit
                if hit then
                    hl.Position = Vector2.new(MX + 4, MY + hit.ry)
                    hl.Size = Vector2.new(MW - 8, RH)
                    hl.Visible = true
                else
                    hl.Visible = false
                end
            end
        end
    else
        dragging = false
        sliding = nil
    end
    wasMouse = md

    -- ===== player / camera position =====
    local mx, my, mz
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if hrp then
        local ok, x, y, z = pcall(xyz, hrp)
        if ok and x then mx, my, mz = x, y, z end
    end
    local cam = workspace.CurrentCamera
    if not mx and cam then
        local ok, x, y, z = pcall(function()
            local p = cam.CFrame.Position
            return p.X, p.Y, p.Z
        end)
        if ok and x then mx, my, mz = x, y, z end
    end

    if mx then
        -- ===== instant grab =====
        if CFG.grab and not listenItem and keyDown(KEYS.grab) and now - lastGrab > GRAB_CD then
            lastGrab = now
            doGrab(mx, my, mz)
        end

        if cam and now - vpAt > 1 then
            vpAt = now
            local ok, vx = pcall(function() return cam.ViewportSize.X end)
            if ok and type(vx) == "number" and vx > 0 then vpX = vx / 2 end
        end
        local cx = vpX

        -- ===== monsters =====
        local nb, na = 0, 0
        if CFG.master then
            local acol = ACOL.alert
            for i = 1, #mons do
                local e = mons[i]
                local ok, x, y, z = pcall(xyz, e.part)
                if ok and x then
                    local dx, dy, dz = x - mx, y - my, z - mz
                    local d = math.sqrt(dx*dx + dy*dy + dz*dz)

                    if CFG.alert and d <= ALERT_DIST and na < 3 then
                        na = na + 1
                        local a = alerts[na]
                        local txt = string.upper(e.base) .. " " .. math.floor(d) .. "m!"
                        if a.txt ~= txt then
                            a.txt = txt
                            a.t.Text = txt
                        end
                        if a.col ~= acol then
                            a.col = acol
                            a.t.Color = acol
                        end
                        a.t.Position = Vector2.new(cx, 70 + (na - 1) * 30)
                        if not a.on then
                            a.t.Visible = true
                            a.on = true
                        end
                    end

                    if (CFG.box or CFG.label) and d <= MON_DIST and nb < BOX_SLOTS then
                        local half = e.h / 2 * (1 + PAD)
                        local ok1, s1, on1 = pcall(WorldToScreen, Vector3.new(x, y + half, z))
                        local ok2, s2, on2 = pcall(WorldToScreen, Vector3.new(x, y - half, z))
                        if ok1 and ok2 and on1 and on2 and s1 and s2 then
                            local top = math.min(s1.Y, s2.Y)
                            local bh = math.abs(s2.Y - s1.Y)
                            if bh > 2 then
                                local bw = bh * BOX_RATIO
                                nb = nb + 1
                                local bx = boxes[nb]
                                local sz = Vector2.new(bw, bh)
                                local ps = Vector2.new(s1.X - bw / 2, top)
                                bx.ol.Size = sz
                                bx.ol.Position = ps
                                bx.b.Size = sz
                                bx.b.Position = ps
                                local col = MCOL[e.base] or WHITE
                                if bx.col ~= col then
                                    bx.col = col
                                    bx.b.Color = col
                                    bx.t.Color = col
                                end
                                local dm = math.floor(d)
                                if e.dm ~= dm then
                                    e.dm = dm
                                    e.txt = e.base .. " [" .. dm .. "m]"
                                end
                                if bx.txt ~= e.txt then
                                    bx.txt = e.txt
                                    bx.t.Text = e.txt
                                end
                                bx.t.Position = Vector2.new(s1.X, top - LABEL_GAP)
                                if bx.sb ~= CFG.box then
                                    bx.sb = CFG.box
                                    bx.ol.Visible = CFG.box
                                    bx.b.Visible = CFG.box
                                end
                                if bx.st ~= CFG.label then
                                    bx.st = CFG.label
                                    bx.t.Visible = CFG.label
                                end
                            end
                        end
                    end
                end
            end
        end

        for i = nb + 1, BOX_SLOTS do
            local bx = boxes[i]
            if bx.sb or bx.st then
                bx.ol.Visible = false
                bx.b.Visible = false
                bx.t.Visible = false
                bx.sb = false
                bx.st = false
            end
        end
        for i = na + 1, 3 do
            if alerts[i].on then
                alerts[i].t.Visible = false
                alerts[i].on = false
            end
        end

        -- ===== loot (every other frame) =====
        if frame % 2 == 0 then
            local vis = 0
            if CFG.master and CFG.loot then
                local minv = SET.minval
                for i = 1, #loot do
                    if vis >= POOL then break end
                    local e = loot[i]
                    local ok, x, y, z = false
                    if e.val >= minv then ok, x, y, z = pcall(xyz, e.part) end
                    if ok and x then
                        local dx, dy, dz = x - mx, y - my, z - mz
                        local d2 = dx*dx + dy*dy + dz*dz
                        if d2 <= lootMax2 then
                            local ok2, sp, on = pcall(WorldToScreen, Vector3.new(x, y, z))
                            if ok2 and on and sp then
                                vis = vis + 1
                                local s = pool[vis]
                                local dm = math.floor(math.sqrt(d2))
                                if e.dm ~= dm then
                                    e.dm = dm
                                    e.txt = e.base .. " [" .. dm .. "m]"
                                end
                                if s.txt ~= e.txt then
                                    s.txt = e.txt
                                    s.t.Text = e.txt
                                end
                                local col = (e.rk and RCOL[e.rk]) or WHITE
                                if s.col ~= col then
                                    s.col = col
                                    s.t.Color = col
                                end
                                s.t.Position = sp
                                if not s.on then
                                    s.t.Visible = true
                                    s.on = true
                                end
                            end
                        end
                    end
                end
            end
            for i = vis + 1, used do
                pool[i].t.Visible = false
                pool[i].on = false
            end
            used = vis
        end
    end
end

-- ===== loop: an error never kills the loop =====
while _G.ESP_TOKEN == TOKEN do
    local now = os.clock()
    pcall(step, now)
    wait()
end

removeAll()
