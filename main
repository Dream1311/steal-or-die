-- ===== menu drawings =====
local mlist, plist = {}, {}
local function mk(kind, list)
    local d = Drawing.new(kind); list[#list + 1] = d; return d
end
local function sq(color, filled, list)
    local s = mk("Square", list or mlist)
    s.Filled = filled ~= false; s.Color = color; s.Visible = false; return s
end
local function tx(size, color, text, list)
    local t = mk("Text", list or mlist)
    t.Size = size; t.Outline = true; t.Color = color; t.Text = text or ""; t.Visible = false; return t
end

