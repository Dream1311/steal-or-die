    t.Size = 24
    t.Center = true
    t.Outline = true
    t.Visible = false
    alerts[i] = {t = t, txt = "", on = false, col = nil}
end

-- ===== menu: drawings =====
local mlist, plist = {}, {}
local function mk(kind, list)
    local d = Drawing.new(kind)
    list[#list + 1] = d
    return d
end
local function sq(color, filled, list)
    local s = mk("Square", list or mlist)
    s.Filled = filled ~= false
    s.Color = color
    s.Visible = false
    return s
end
local function tx(size, color, text, list)
    local t = mk("Text", list or mlist)
    t.Size = size
    t.Outline = true
    t.Color = color
    t.Text = text or ""
    t.Visible = false
    return t
end

local items = {}
local function add(kind, label, tbl, key)
    items[#items + 1] = {k = kind, l = label, t = tbl, key = key}
end
add("b", "Menu key", nil, "menu")
add("b", "Grab key", nil, "grab")
add("h", "FEATURES")
add("t", "ESP master", CFG, "master")
add("t", "Instant grab", CFG, "grab")
add("t", "Loot ESP", CFG, "loot")
add("s", "Min price", SET, "minval")
add("t", "Monster box", CFG, "box")
add("t", "Monster label", CFG, "label")
add("t", "Monster alert", CFG, "alert")
add("h", "LOOT COLORS")
for _, r in ipairs(RORDER) do add("c", r, RCOL, r) end
add("h", "MONSTER COLORS")
for _, m in ipairs(MON_ORDER) do add("c", m, MCOL, m) end
add("h", "ALERT COLOR")
add("c", "Alert text", ACOL, "alert")

